ADMIN_PASSWORD=change-me

# Game backend: "mock" (browser-only demo) or "chain" (Monad Testnet). Default stays mock until a real wallet run is confirmed.
NEXT_PUBLIC_GAME_BACKEND=mock
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Optional: Privy App ID (public, from dashboard.privy.io). Empty = browser-wallet login only. Never put a Privy secret here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only secrets (never prefix with NEXT_PUBLIC_). Testnet wallets only.
ADMIN_PRIVATE_KEY=
DRIP_PRIVATE_KEY=
# Optional: bearer token for the scheduled keepalive route GET /api/cron/keepalive
CRON_SECRET=
# Optional faucet tuning (MON): DRIP_AMOUNT_MON=0.1 DRIP_MIN_BALANCE_MON=0.05 DRIP_DAILY_CAP_MON=2 DRIP_PER_IP_PER_HOUR=5
